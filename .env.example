# FlexyFilm Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (leave empty or use mongodb://localhost:27017/flexyfilm)
# If MongoDB is not running, FlexyFilm automatically falls back to its built-in memory/seed store!
MONGO_URI=mongodb://localhost:27017/flexyfilm

# JWT Secret for User Authentication
JWT_SECRET=flexyfilm_ultra_secure_jwt_secret_key_2025_cinema

# TMDB (The Movie Database) API Configuration (Optional)
# Get your free key at https://www.themoviedb.org/settings/api
# If no key is provided, FlexyFilm automatically serves high-definition regional & international curated movie streams!
TMDB_API_KEY=
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE=https://image.tmdb.org/t/p

# Client Configuration
CLIENT_URL=http://localhost:5173
